#!/bin/sh
# run-cron /api/cron/<name>: call one cron route the way Vercel does, log one line to the
# container's stdout. Also usable by hand: docker compose exec scheduler run-cron /api/cron/<name>
# crond starts jobs with an empty environment, so the values come from the file entrypoint.sh wrote.
[ -f /run/cron.env ] && . /run/cron.env
# From crond (no terminal), log to the container's stdout; by hand, print to the terminal.
[ -t 1 ] || exec >/proc/1/fd/1 2>&1
out=$(mktemp)
# 330s: the longest route's maxDuration is 300s.
code=$(curl -sS -o "$out" -w '%{http_code}' --max-time 330 \
  -H "Authorization: Bearer $CRON_SECRET" "$APP_URL$1")
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) GET $1 -> $code $(head -c 300 "$out" | tr '\n' ' ')"
rm -f "$out"
[ "$code" -ge 200 ] 2>/dev/null && [ "$code" -lt 300 ]
