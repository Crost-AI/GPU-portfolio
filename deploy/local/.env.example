# deploy/local/.env: made from this file by scripts/gen-keys.sh, which fills in the secrets.
# Never commit .env (deploy/local/.gitignore). Back it up with the data: losing ENCRYPTION_KEY
# makes every stored credential unreadable, and changing JWT_SECRET signs every user out.

# ── Secrets (scripts/gen-keys.sh generates these) ────────────────────────────────────────────
# Password of the `postgres` role and of the Supabase service roles (auth, storage, rest).
# Read once, when the database volume is first created; changing it later does not re-key the db.
POSTGRES_PASSWORD=
# HS256 secret that GoTrue signs session tokens with and PostgREST/Storage verify. 32+ chars.
JWT_SECRET=
# JWTs signed with JWT_SECRET: role "anon" (public, shipped to the browser) and role
# "service_role" (bypasses RLS; server only). Remint both if JWT_SECRET changes.
ANON_KEY=
SERVICE_ROLE_KEY=
# 64 hex chars. Encrypts stored API keys and credentials (lib/crypto.ts). Never rotate casually.
ENCRYPTION_KEY=
# Bearer token the scheduler sends to /api/cron/* (lib/security/cron-auth.ts).
CRON_SECRET=
# Encrypts connection strings in Studio's pg-meta (only used with --profile studio).
PG_META_CRYPTO_KEY=

# ── URLs ───────────────────────────────────────────────────────────────────────────────────────
# The app's origin as the browser sees it (= NEXT_PUBLIC_SITE_URL). Must ALSO be reachable from
# inside the app container: the agent requests its own PDF routes at this URL. The default works
# because the app shares Kong's network namespace. Compiled into the app: rebuild after changing.
SITE_URL=http://localhost:3000
# Kong's origin as the browser sees it (= NEXT_PUBLIC_SUPABASE_URL). The app's server calls it
# too, so it must resolve from inside the app container as well. Rebuild the app after changing.
SUPABASE_PUBLIC_URL=http://localhost:8000
# Extra redirect URLs GoTrue accepts after sign-in, comma-separated (e.g. a second hostname).
ADDITIONAL_REDIRECT_URLS=

# ── Ports ──────────────────────────────────────────────────────────────────────────────────────
# Interface the app and Kong listen on. 127.0.0.1 = this machine only; 0.0.0.0 = the LAN too
# (then put a TLS reverse proxy in front and set SITE_URL / SUPABASE_PUBLIC_URL to its URLs).
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
KONG_HTTP_PORT=8000
# Postgres on 127.0.0.1, for scripts/migrate.sh and psql. Not 5432, to leave a host Postgres alone.
POSTGRES_HOST_PORT=54322
STUDIO_PORT=54323
MAILPIT_PORT=54324

# ── PostgREST ──────────────────────────────────────────────────────────────────────────────────
# Most rows one unpaginated read returns. supabase/config.toml says 1000; see RUNBOOK.md.
PGRST_DB_MAX_ROWS=10000
# Session token lifetime in seconds (supabase/config.toml jwt_expiry).
JWT_EXPIRY=3600

# ── Auth email (GoTrue SMTP) ───────────────────────────────────────────────────────────────────
# Defaults deliver to Mailpit (start with --profile mail, read at http://127.0.0.1:54324).
# For real delivery, point these at your SMTP provider. With no SMTP at all, sign in with a
# password instead: scripts/bootstrap-admin.sh sets one.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Portfolio
SMTP_ADMIN_EMAIL=admin@example.com

# ── Optional: AO supervisor label on every container ───────────────────────────────────────────
# AO_SESSION=

# ── Optional app settings (see the repo-root .env.example) ─────────────────────────────────────
# The app container gets ONLY the variables named under `app.environment` in docker-compose.yml,
# never this whole file: to pass another, add its name there. NEXT_PUBLIC_* are compiled in, so
# they need `dc build app`; the rest need `dc up -d app`.
# NEXT_PUBLIC_TERMS_URL=
# NEXT_PUBLIC_PRIVACY_URL=
# NEXT_PUBLIC_DISABLE_SW=true
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# MAILGUN_API_KEY=
# MAILGUN_WEBHOOK_SIGNING_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EMAIL_FROM=
# AGENT_DESTRUCTIVE_ACTIONS=true
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# TRANSCRIPTION_WEBHOOK_URL=
# ENABLE_SETUP_PAGE=true
# CUTOVER_SKIP_VEHICLES=
