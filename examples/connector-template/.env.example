# The Portfolio deployment to feed. Its MCP endpoint is <PORTFOLIO_URL>/api/mcp.
PORTFOLIO_URL=https://portfolio.example.com
# A fund API key with read & write scope, from Settings → API and MCP. Starts with lk_.
# Give it its own key, so revoking the connector revokes nothing else.
PORTFOLIO_API_KEY=lk_...
# The entity (vehicle) whose books this connector feeds, by name.
PORTFOLIO_VEHICLE=Fund I

# Where cursors and tokens are kept between runs (default .state/).
CONNECTOR_STATE_DIR=.state
